<form version="1.1" theme="light">
  <label>SOC Monitoring Dashboard - BOTS v3</label>
  <description>Historical security telemetry for Windows logon monitoring and triage.</description>
  <fieldset submitButton="false"><input type="time" token="timestamp" searchWhenChanged="true"><label>Event time range</label><default><earliest>0</earliest><latest></latest></default></input></fieldset>
  <row><panel><html><div style="background-color:#14263D;color:#F4F8FC;padding:16px 22px;border-radius:8px"><div style="font-size:22px;font-weight:700">Windows authentication overview</div><div style="font-size:13px;margin-top:4px">BOTS v3 lab telemetry | Aug 2018</div></div></html></panel></row>
  <row>
    <panel><single><title>Total BOTS v3 events</title><search><query>index=botsv3 | stats count</query><earliest>$timestamp.earliest$</earliest><latest>$timestamp.latest$</latest></search><option name="height">104</option><option name="useColors">1</option><option name="colorMode">value</option><option name="rangeValues">[0]</option><option name="rangeColors">["0x254B75","0x254B75"]</option><option name="drilldown">none</option></single></panel>
    <panel><single><title>Failed Windows logons (4625)</title><search><query>index=botsv3 sourcetype=wineventlog:security EventCode=4625 | stats count</query><earliest>$timestamp.earliest$</earliest><latest>$timestamp.latest$</latest></search><option name="height">104</option><option name="useColors">1</option><option name="colorMode">value</option><option name="rangeValues">[0]</option><option name="rangeColors">["0xB33F45","0xB33F45"]</option><option name="drilldown">none</option></single></panel>
    <panel><single><title>Successful Windows logons (4624)</title><search><query>index=botsv3 sourcetype=wineventlog:security EventCode=4624 | stats count</query><earliest>$timestamp.earliest$</earliest><latest>$timestamp.latest$</latest></search><option name="height">104</option><option name="useColors">1</option><option name="colorMode">value</option><option name="rangeValues">[0]</option><option name="rangeColors">["0x087B70","0x087B70"]</option><option name="drilldown">none</option></single></panel>
  </row>
  <row>
    <panel><chart><title>Windows authentication over time</title><search><query>index=botsv3 sourcetype=wineventlog:security (EventCode=4624 OR EventCode=4625) | eval Outcome=if(EventCode=4625,"Failed","Successful") | timechart bins=35 count by Outcome</query><earliest>$timestamp.earliest$</earliest><latest>$timestamp.latest$</latest></search><option name="charting.chart">column</option><option name="charting.legend.placement">bottom</option><option name="charting.axisTitleX.visibility">collapsed</option><option name="charting.seriesColors">[0xC44536,0x007C83]</option><option name="charting.drilldown">none</option><option name="height">235</option></chart></panel>
    <panel><chart><title>Top 10 Windows security event codes</title><search><query>index=botsv3 sourcetype=wineventlog:security | stats count AS Events by EventCode | sort 10 -Events</query><earliest>$timestamp.earliest$</earliest><latest>$timestamp.latest$</latest></search><option name="charting.chart">bar</option><option name="charting.legend.placement">none</option><option name="charting.axisTitleX.visibility">collapsed</option><option name="charting.seriesColors">[0x466C96]</option><option name="charting.drilldown">none</option><option name="height">235</option></chart></panel>
  </row>
  <row>
    <panel><table><title>Failed logon triage</title><search><query>index=botsv3 sourcetype=wineventlog:security EventCode=4625 | sort 50 -_time | eval Account=coalesce(TargetUserName, Account_Name, user, "(unavailable)"), Source=coalesce(IpAddress, Source_Network_Address, src_ip, src, "(unavailable)") | convert ctime(_time) | rename _time AS Time, host AS Host, Logon_Type AS "Logon type" | table Time Host Account Source "Logon type"</query><earliest>$timestamp.earliest$</earliest><latest>$timestamp.latest$</latest></search><option name="count">10</option><option name="drilldown">none</option></table></panel>
    <panel><chart><title>Top indexed source types</title><search><query>| tstats count WHERE index=botsv3 BY sourcetype | rename count AS Events | sort 8 -Events</query><earliest>$timestamp.earliest$</earliest><latest>$timestamp.latest$</latest></search><option name="charting.chart">bar</option><option name="charting.legend.placement">none</option><option name="charting.axisTitleX.visibility">collapsed</option><option name="charting.seriesColors">[0x007C83]</option><option name="charting.drilldown">none</option><option name="height">235</option></chart></panel>
  </row>
</form>
